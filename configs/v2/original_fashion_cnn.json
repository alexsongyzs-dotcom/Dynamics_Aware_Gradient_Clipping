{
  "name": "original-v2-fashion-cnn-lr0.8",
  "dataset": "fashion_mnist",
  "model": "small_cnn",
  "optimizer": "sgd",
  "epochs": 15,
  "batch_size": 256,
  "lr": 0.8,
  "momentum": 0.9,
  "weight_decay": 0.0001,
  "num_workers": 0,
  "train_size": 5000,
  "test_size": 2000,
  "projection_dim": 8,
  "divergence_loss": 100.0,
  "divergence_jump": 50.0,
  "clipping": {
    "name": "dagc",
    "init_c": 0.5,
    "gamma": 0.05,
    "beta": 0.9,
    "relax": 0.3,
    "osc_weight": 3.0,
    "beta_a": 0.9,
    "c_min_scale": 0.1,
    "c_max_scale": 10.0,
    "norm_window": 200,
    "exposure_target": 0.1
  }
}
